# Copy to .env.local and adjust. NEXT_PUBLIC_* values are baked in at build time.

# Production URL, no trailing slash. Used for canonical URLs, the sitemap and structured data.
# Confirm the exact domain (e.g. https://royalwaterproofingco.com) before launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Let search engines index the site. Keep false until the launch blockers are cleared
# (`npm run check:content` passes) and the site is on its real domain. With this on, the build
# stops unless NEXT_PUBLIC_SITE_URL is the production https:// domain. Preview mode is never indexed.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Preview mode: shows the invented sample content (projects, reviews, gallery, stats,
# warranty terms) with "Sample" badges, to review layouts. Never enable in production.
# NEXT_PUBLIC_PREVIEW_SAMPLES=true

# Lead API (server-only) — the ERP's Django `leads` app saves each enquiry and sends the email and WhatsApp
# notifications (docs/API_NOTIFICATION_ARCHITECTURE.md). Leave LEADS_API_URL empty to simulate delivery, as local
# development and the e2e tests do: the form still works, but enquiries aren't delivered anywhere.
# The visitor's IP is read from X-Forwarded-For: Vercel sets it; behind your own proxy, make the proxy overwrite it
# (nginx: proxy_set_header X-Forwarded-For $remote_addr;) so visitors can't spoof it.
# LEADS_API_URL=https://api.example.com/api
# Shared secret, the same value as LEADS_API_KEY in the Django backend.
# LEADS_API_KEY=
# How long to wait for the API before showing the error with Call / WhatsApp buttons (ms, default 8000).
# LEADS_API_TIMEOUT_MS=8000

# Server-only testing switch for the enquiry form: "error" makes every submission fail,
# so you can see the error state. Leave unset in production.
# LEAD_SUBMIT_MODE=error

# Website assistant — optional self-hosted language model (server-only; see "Website assistant" in the README).
# The assistant works without these: it answers straight from the site's content. Set both to let a model you
# run yourself (Ollama, llama.cpp's llama-server, LM Studio, vLLM) word the answers, still only from that content.
# Never point these at a paid AI API — that's the cost this setup avoids.
# CHAT_MODEL_URL=http://localhost:11434/v1
# CHAT_MODEL=qwen3:4b-instruct
# Bearer token, only if the model server sits behind a proxy that checks one.
# CHAT_MODEL_API_KEY=
# How long to wait for the model before answering from the content instead (ms, default 20000).
# CHAT_MODEL_TIMEOUT_MS=20000
